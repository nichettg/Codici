   "source": [
    "import numpy as np\n",
    "from phaseportrait import PhasePortrait2D\n",
    "\n",
    "def system1(x, v):\n",
    "    return v, x - x**3\n",
    "\n",
    "def system2(x, v):\n",
    "    return v, -x - x**2\n",
    "\n",
    "def system3(x, v, a=1, D=1):\n",
    "    return v, -a*D*np.exp(-a*x)*(1 - np.exp(-a*x))\n",
    "\n",
    "pp = PhasePortrait2D(system2, [-2, 2])\n",
    "pp.plot()"
   ]
  }
 ],
