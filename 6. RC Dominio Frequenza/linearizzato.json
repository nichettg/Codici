            "ylabel": "\\tan(\\Phi)",
            "yunit": "-"
        }
    },

    "output": {
        "regressione": "regressione",
        "residui": "residui",
        "chi": "chi"
    },

    "cartella": {
        "input": "data",
        "output": "linearizzato"
    }
}