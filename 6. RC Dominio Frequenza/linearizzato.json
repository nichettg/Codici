{
    "metodi": {
        "A": {
            "file_input": "dati_A_lin.csv",
            "titolo": "Ampiezza Linearizzata",
            "xlabel": "f^2",
            "xunit": "Hz^2",
            "ylabel": "A^{-2}",
            "yunit": "-"
        },
        "phi": {
            "file_input": "dati_phi_lin.csv",
